{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/schrodinger.iwsdk.scene.json",
  "assets": {
    "module": "./src/assets"
  },
  "components": {
    "module": "./src/components"
  },
  "world": {
    "xr": {
      "mode": "immersive-vr",
      "offer": "always",
      "features": {
        "hand-tracking": "required",
        "hit-test": "optional",
        "local-floor": "required"
      }
    },
    "input": {
      "canvasPointerEvents": true
    },
    "render": {
      "near": 0.05,
      "far": 100,
      "camera": {
        "position": [0, 1.4, 1.6],
        "lookAt": [0, 0.9, 0]
      }
    }
  }
}
